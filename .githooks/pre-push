#!/usr/bin/env bash
# agent-ready pre-push hook: run local CI before anything reaches GitHub,
# so GitHub-hosted CI minutes aren't spent finding failures you could catch here.
# Skips if this exact commit already passed (e.g. Claude's push gate just ran it).
# Emergency bypass for you (not Claude, which is denied it): git push --no-verify
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
cfg="$root/.claude/agent-ready.json"
marker="$(git rev-parse --absolute-git-dir)/agent-ready-ci-pass"
head="$(git rev-parse HEAD)"

ci_cmd="scripts/ci-local.sh"
if [ -f "$cfg" ] && command -v python3 >/dev/null; then
  ci_cmd="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("ci_local") or "")' "$cfg")"
fi
[ -z "$ci_cmd" ] && exit 0

if [ -f "$marker" ] && [ "$(cat "$marker")" = "$head" ]; then
  echo "agent-ready: local CI already passed for ${head:0:8}, pushing."
  exit 0
fi

echo "agent-ready: running local CI ($ci_cmd) before push..."
cd "$root"
if bash -c "$ci_cmd"; then
  if [ -z "$(git status --porcelain --untracked-files=no)" ]; then
    echo "$head" > "$marker"
  fi
  exit 0
else
  echo "agent-ready: local CI failed, push blocked." >&2
  exit 1
fi
