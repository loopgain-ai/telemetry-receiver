{
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Read(!.env.sample)",
      "Read(*.pem)",
      "Read(*.p12)",
      "Read(*.mobileprovision)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/**)",
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push -f *)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push --no-verify*)",
      "Bash(git push * --no-verify*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(git stash drop*)",
      "Bash(git stash clear*)",
      "Bash(git branch -D *)",
      "Bash(supabase db reset*)",
      "Bash(npm run deploy*)",
      "Bash(wrangler deploy*)",
      "Bash(npx wrangler deploy*)",
      "Bash(wrangler delete*)",
      "Bash(npx wrangler delete*)",
      "Bash(wrangler secret *)",
      "Bash(npx wrangler secret *)",
      "Bash(wrangler d1 delete*)",
      "Bash(npx wrangler d1 delete*)",
      "Bash(npm run db:*:remote*)",
      "Bash(wrangler d1 * --remote*)",
      "Bash(npx wrangler d1 * --remote*)",
      "Bash(npm run rotate-token*)",
      "Bash(node scripts/rotate-token.mjs*)",
      "Bash(npm run issue-token*)",
      "Bash(node scripts/issue-token.mjs*)"
    ]
  }
}
